# The Apex Mentor calls Claude from a serverless function (api/mentor.ts).
# Set this in your Vercel project settings (or a local .env) to enable live AI.
# Without it, the mentor falls back to scripted Breaching/Diving prompts.
ANTHROPIC_API_KEY=sk-ant-...

# Supabase (auth, profiles, survey_responses). Required — the app crashes at
# startup without them. Find both under Supabase → Project Settings → API.
# The anon key is safe to expose to the browser ONLY because Row-Level
# Security is enabled (see supabase/schema.sql).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
