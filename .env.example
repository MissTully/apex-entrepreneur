# The Apex Mentor calls Claude from a serverless function (api/mentor.ts).
# Set this in your Vercel project settings (or a local .env) to enable live AI.
# Without it, the mentor falls back to scripted Breaching/Diving prompts.
ANTHROPIC_API_KEY=sk-ant-...

# Supabase (auth, profiles, survey_responses). Required — the app crashes at
# startup without them. Find both under Supabase → Project Settings → API.
# The anon key is safe to expose to the browser ONLY because Row-Level
# Security is enabled (see supabase/schema.sql).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Survey submission email alerts (api/survey-notify.ts) — optional.
# Full setup steps: docs/survey-data-access.md (Option B).
RESEND_API_KEY=re_...
SURVEY_NOTIFY_TO=you@example.com
SURVEY_WEBHOOK_SECRET=any-long-random-string
# Optional: lets the alert email include the participant's name + email.
# The service_role key bypasses row security — server-side only, never
# commit it and never expose it to the browser (no VITE_ prefix!).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
